<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EcoColeta - Protótipo Interativo</title>
    <style>
        :root {
            --primary: #2e7d32;
            --primary-light: #4caf50;
            --accent: #ffb300;
            --bg: #f4f6f8;
            --card-bg: #ffffff;
            --text: #333333;
            --text-light: #666666;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        /* Simulação de Tela de Smartphone */
        .phone-frame {
            width: 100%;
            max-width: 410px;
            height: 840px;
            background-color: var(--card-bg);
            border-radius: 40px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            border: 10px solid #222;
            position: relative;
        }

        /* Barra de Status Fictícia */
        .status-bar {
            background-color: #222;
            color: white;
            padding: 8px 20px;
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            font-weight: 600;
        }

        /* Cabeçalho do App */
        .app-header {
            background-color: var(--primary);
            color: white;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .app-header h1 {
            font-size: 20px;
        }

        .user-avatar {
            background-color: var(--accent);
            color: #333;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        /* Área de Conteúdo Dinâmico */
        .app-content {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: none;
        }

        .app-content.active {
            display: block;
        }

        /* Navegação Inferior (Abas) */
        .nav-bar {
            display: flex;
            background-color: white;
            border-top: 1px solid #ddd;
            height: 70px;
        }

        .nav-item {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-light);
            font-size: 11px;
            transition: 0.2s;
        }

        .nav-item.active {
            color: var(--primary);
            font-weight: bold;
        }

        .nav-item span.icon {
            font-size: 20px;
            margin-bottom: 3px;
        }

        /* Estilos dos Componentes das Telas */
        .card {
            background: white;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 15px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            border-left: 5px solid var(--primary-light);
        }

        .card h3 {
            font-size: 16px;
            margin-bottom: 8px;
            color: var(--primary);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 15px;
        }

        .stat-box {
            background: #e8f5e9;
            padding: 12px;
            border-radius: 10px;
            text-align: center;
        }

        .stat-box h4 {
            font-size: 12px;
            color: var(--text-light);
        }

        .stat-box p {
            font-size: 18px;
            font-weight: bold;
            color: var(--primary);
            margin-top: 5px;
        }

        .btn {
            background-color: var(--primary);
            color: white;
            border: none;
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.2s;
            margin-top: 10px;
        }

        .btn:hover {
            background-color: #1b5e20;
        }

        /* Mapa Fictício */
        .map-box {
            background: #e0e0e0;
            height: 220px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            margin-bottom: 15px;
        }

        .map-pin {
            position: absolute;
            background: var(--accent);
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            cursor: pointer;
        }

        /* Formulários */
        .form-group {
            margin-bottom: 12px;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            margin-bottom: 5px;
            font-weight: 600;
        }

        .form-group select, .form-group input {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 14px;
        }

        /* Alertas e Dicas */
        .tip-card {
            background: #fff8e1;
            border-left-color: var(--accent);
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 10px;
            font-size: 13px;
        }
    </style>
</head>
<body>

<div class="phone-frame">
    <!-- Barra de Status -->
    <div class="status-bar">
        <span>09:41</span>
        <span>📶 🔋 100%</span>
    </div>

    <!-- Cabeçalho -->
    <div class="app-header">
        <h1>EcoColeta</h1>
        <div class="user-avatar">JC</div>
    </div>

    <!-- CONTEÚDO DAS TELAS -->

    <!-- TELA 1: INÍCIO -->
    <div id="tab-inicio" class="app-content active">
        <div class="card">
            <h3>Olá, João Catador! 👋</h3>
            <p style="font-size: 13px; color: var(--text-light);">Sua meta diária está quase lá. Continue firme!</p>
        </div>

        <div class="stats-grid">
            <div class="stat-box">
                <h4>Coletado Hoje</h4>
                <p id="peso-hoje">48 kg</p>
            </div>
            <div class="stat-box">
                <h4>Meta Diária</h4>
                <p>60 kg</p>
            </div>
        </div>

        <div class="card">
            <h3>📍 Próxima Parada Otimizada</h3>
            <p><strong>Comércio Central</strong> - Papelão e Alumínio</p>
            <p style="font-size: 12px; color: var(--text-light); margin-top: 4px;">Distância estimada: 300m</p>
            <button class="btn" onclick="mudarAba('mapa')">Ver no Mapa de Rotas</button>
        </div>

        <div class="card" style="border-left-color: var(--accent);">
            <h3>💡 Dica de Ergonomia do Dia</h3>
            <p style="font-size: 13px;">Mantenha a coluna reta ao levantar sacas pesadas. Use os joelhos como alavanca!</p>
        </div>
    </div>

    <!-- TELA 2: MAPA DE ROTAS -->
    <div id="tab-mapa" class="app-content">
        <div class="card">
            <h3>Planejamento de Rota Inteligente</h3>
            <p style="font-size: 13px; color: var(--text-light);">Economize percurso e evite peso desnecessário.</p>
        </div>

        <div class="map-box">
            <!-- Simulação de pontos no mapa -->
            <div class="map-pin" style="top: 40px; left: 50px;" onclick="alert('Ponto 1: Supermercado Local (Pronto para coleta)')">1. Supermercado</div>
            <div class="map-pin" style="top: 120px; right: 60px; background: #a5d6a7;" onclick="alert('Ponto 2: Residência Dona Maria (Coletado)')">2. Dona Maria (✔)</div>
            <div class="map-pin" style="bottom: 30px; left: 100px;" onclick="alert('Ponto 3: Comércio Central (Aguardando)')">3. Comércio</div>
            <p style="position: absolute; bottom: 10px; font-size: 11px; color: #555;">[ Simulação de Mapa GPS Integrado ]</p>
        </div>

        <button class="btn" onclick="alert('Rota recalculada com sucesso! Menor declive e distância.')">Recalcular Melhor Rota</button>
    </div>

    <!-- TELA 3: REGISTRO DE MATERIAIS -->
    <div id="tab-registro" class="app-content">
        <div class="card">
            <h3>Novo Registro de Coleta</h3>
            <p style="font-size: 13px; color: var(--text-light);">Informe o que foi recolhido para atualizar seus ganhos.</p>
        </div>

        <div class="form-group">
            <label>Tipo de Material</label>
            <select id="tipo-material">
                <option value="Plástico">Plástico (PET / PE)</option>
                <option value="Papelão">Papelão / Papel</option>
                <option value="Alumínio">Alumínio / Latinhas</option>
                <option value="Vidro">Vidro</option>
            </select>
        </div>

        <div class="form-group">
            <label>Peso Aproximado (kg)</label>
            <input type="number" id="peso-input" value="10" min="1">
        </div>

        <div class="form-group">
            <label>Condição / Volume</label>
            <select>
                <option>Pequeno volume (Sacola)</option>
                <option>Médio volume (Carrinho)</option>
                <option>Grande volume (Saca/Fardo)</option>
            </select>
        </div>

        <button class="btn" onclick="registrarColeta()">Salvar e Atualizar</button>
    </div>

    <!-- TELA 4: RELATÓRIOS E APOIO -->
    <div id="tab-relatorios" class="app-content">
        <div class="card">
            <h3>Produtividade Semanal</h3>
            <p style="font-size: 13px; color: var(--text-light);">Total acumulado na semana: <strong id="total-semana">215 kg</strong></p>
        </div>

        <div class="card" style="border-left-color: var(--accent);">
            <h3>🛡️ Área de Apoio e Segurança</h3>
            <div class="tip-card">
                <strong>Equipamentos recomendados:</strong> Utilize sempre luvas de raspa de couro e calçados fechados com sola antiderrapante.
            </div>
            <div class="tip-card">
                <strong>Prevenção de Lesões:</strong> Divida cargas muito pesadas em dois trajets. Sua saúde é o seu principal instrumento de trabalho!
            </div>
        </div>
    </div>

    <!-- MENU DE NAVEGAÇÃO INFERIOR -->
    <div class="nav-bar">
        <button class="nav-item active" onclick="mudarAba('inicio')" id="btn-inicio">
            <span class="icon">🏠</span>
            <span>Início</span>
        </button>
        <button class="nav-item" onclick="mudarAba('mapa')" id="btn-mapa">
            <span class="icon">🗺️</span>
            <span>Mapa</span>
        </button>
        <button class="nav-item" onclick="mudarAba('registro')" id="btn-registro">
            <span class="icon">➕</span>
            <span>Registrar</span>
        </button>
        <button class="nav-item" onclick="mudarAba('relatorios')" id="btn-relatorios">
            <span class="icon">📊</span>
            <span>Relatórios</span>
        </button>
    </div>
</div>

<script>
    let pesoAtualTotal = 48;

    function mudarAba(abaId) {
        // Remove active de todas as abas e conteúdos
        document.querySelectorAll('.app-content').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));

        // Ativa a aba e o conteúdo selecionado
        document.getElementById('tab-' + abaId).classList.add('active');
        document.getElementById('btn-' + abaId).classList.add('active');
    }

    function registrarColeta() {
        const pesoAdicional = parseInt(document.getElementById('peso-input').value) || 0;
        pesoAtualTotal += pesoAdicional;
        
        // Atualiza na tela inicial
        document.getElementById('peso-hoje').innerText = pesoAtualTotal + ' kg';
        
        alert('Coleta registrada com sucesso! Estatísticas atualizadas.');
        mudarAba('inicio');
    }
</script>

</body>
</html>
